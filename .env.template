# ==========================================
# Plantilla de Credenciales for Skills / IAs
# ==========================================

# Integraciones and Servicios Externos
GITHUB_TOKEN=tu_github_token_aqui
SUPABASE_ACCESS_TOKEN=tu_supabase_token_aqui
MERCADOPAGO_ACCESS_TOKEN=tu_mercadopago_token_aqui

# APIs de Modelos de Terceros (opcional / no utilizados by default)
# ANTHROPIC_API_KEY=tu_api_key_aqui
# OPENAI_API_KEY=tu_api_key_aqui

# Local MCP routes / endpoints
MCP_ANGULAR_DOCS_URL=http://localhost:3000/mcp/angular

# Navegador for el MCP playwright. Lo resuelve setup.sh / setup.ps1
# automatically (chrome if Chrome esta instalado, if no chromium).
# Do not edit manually: se sobrescribe in cada ejecucion of the setup.
# PLAYWRIGHT_BROWSER=chrome

# Memoria local per-user of the MCP memory (la define setup.sh / memory-setup.sh).
# Never committed; ruta tipica: ~/.local/share/opencode/memory/<github-user>.jsonl
# MEMORY_FILE_PATH=~/.local/share/opencode/memory/<user>.jsonl
