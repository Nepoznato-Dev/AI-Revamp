# ==========================================
# Credentials template for skills and AI tools
# ==========================================

# External integrations and services
GITHUB_TOKEN=your_github_token_here
SUPABASE_ACCESS_TOKEN=your_supabase_token_here
MERCADOPAGO_ACCESS_TOKEN=your_mercadopago_token_here

# Third-party model APIs (optional / unused by default)
# ANTHROPIC_API_KEY=your_api_key_here
# OPENAI_API_KEY=your_api_key_here

# Local MCP routes / endpoints
MCP_ANGULAR_DOCS_URL=http://localhost:3000/mcp/angular

# Browser for the Playwright MCP. Resolved automatically by setup.sh / setup.ps1
# (chrome when Chrome is installed, otherwise chromium).
# Do not edit manually: overwritten on every setup run.
# PLAYWRIGHT_BROWSER=chrome

# Local per-user memory for the memory MCP (set by setup.sh / memory-setup.sh).
# Never committed; typical path: ~/.local/share/opencode/memory/<github-user>.jsonl
# MEMORY_FILE_PATH=~/.local/share/opencode/memory/<user>.jsonl
